{
	"schemaVersion": 1,
	"id": "btd",
	"version": "${version}",
	"name": "Better Than Deer",
	"description": "A mod for Better Than Adventure that changes various features in the game to follow a more structured, connected vision for the world and gameplay experience.",
	"authors": [
		"MelonBTA Modding"
	],
	"contact": {
		"homepage": "",
		"sources": ""
	},
	"icon": "icon.png",
	"license": "CC0-1.0",
	"environment": "*",
	"accessWidener": "btd.accesswidener",
	"entrypoints": {
		"main": [
			"betterthandeer.btd.BetterThanDeerMod"
		],
		"beforeGameStart": [
			"betterthandeer.btd.BetterThanDeerMod"
		],
		"afterGameStart": [
			"betterthandeer.btd.BetterThanDeerMod"
		],
		"beforeClientStart": [
			"betterthandeer.btd.BTDClient"
		],
		"afterClientStart": [
			"betterthandeer.btd.BTDClient"
		],
		"recipesReady": [
			"betterthandeer.btd.BTDRecipes"
		],
		"initModels": [
			"betterthandeer.btd.model.BTDModels"
		],
		"afterItemInit": [
			"betterthandeer.btd.BetterThanDeerMod"
		]
	},
	"mixins": [
      "btd.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabricloader}",
		"halplibe": ">=${halplibe}",
		"minecraft": "*",
		"java": ">=${java}"
	},
	"suggests": {
		"modmenu": ">=${modmenu}"
	}
}
